# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored — never commit real credentials.

# SQLAlchemy connection string (MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/matchwise_db

# ---- API authentication (Phase 5.1) ----
# Local operator token. When set, every /api/resumes*, /api/jobs* and
# /api/matches* request must send it as `Authorization: Bearer <token>` or
# `X-API-Token: <token>`. Leave empty to disable auth (local development).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-with-a-long-random-token

# Comma-separated list of allowed frontend origins (Vite uses 5173 and falls
# back to 5174 when 5173 is occupied — allow localhost and 127.0.0.1 for both)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Local upload storage for resumes (created automatically; never served publicly)
# UPLOAD_DIR=C:\path\to\backend\uploads

# Max resume upload size in bytes (default 5 MB)
UPLOAD_MAX_BYTES=5242880

# ---- Matching engine (Phase 3) ----
# Scoring weights (renormalised over the available components at runtime)
MATCH_WEIGHT_REQUIRED=0.60
MATCH_WEIGHT_PREFERRED=0.15
MATCH_WEIGHT_SEMANTIC=0.25
# Typo tolerance for skill matching (0 disables fuzzy matching)
MATCH_FUZZY_THRESHOLD=0.9
# Semantic similarity (requires requirements-semantic.txt)
MATCH_SEMANTIC_ENABLED=true
MATCH_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Extra skill taxonomy merged into the built-in one (JSON, same shape)
# SKILL_TAXONOMY_PATH=C:\path\to\extra_skills.json

# ----- Live job provider (Phase 7) -----
# JobsForce India is the only external job source and its public API needs
# NO credentials. Nothing to obtain, nothing to keep secret.
# Optional overrides:
# JOBSFORCE_BASE_URL=https://jobsforceindia.com
# How long filter values (cities/categories/job types/work modes) are cached.
# JOBSFORCE_CATALOG_TTL=600
# Max full-detail requests per search page (best-effort enrichment, 0-20).
# IMPORT_DETAIL_LOOKUPS=20
# Imported listings unseen for N days become "stale"; older than M expire.
# IMPORT_STALE_DAYS=14
# IMPORT_EXPIRE_DAYS=45

# ---- Feedback-aware ranking (Phase 6) ----
# Feedback only adjusts ranking; the stored engine score is never modified.
FEEDBACK_RANKING_ENABLED=true
# Strict cap on the absolute adjustment, in score points (0-100 scale).
FEEDBACK_MAX_ADJUSTMENT=10
# Relative influence of job-specific / skill-category / company feedback
# (normalised to sum to 1 at runtime).
FEEDBACK_WEIGHT_JOB=0.5
FEEDBACK_WEIGHT_CATEGORY=0.3
FEEDBACK_WEIGHT_COMPANY=0.2
# Additive smoothing: larger values need more consistent feedback to matter.
FEEDBACK_SMOOTHING=2

# development | production
ENVIRONMENT=development
