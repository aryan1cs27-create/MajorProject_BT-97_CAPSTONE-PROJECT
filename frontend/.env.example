# Copy this file to `.env.local` (or `.env`) and adjust if needed.
# `.env*` files are git-ignored.
VITE_API_BASE_URL=http://localhost:8001/api

# Phase 5.1: local API token. Must match API_TOKEN in backend/.env.
# Leave empty when the backend has no API_TOKEN configured (auth disabled).
# VITE_API_TOKEN=replace-with-the-backend-API_TOKEN

# Phase 7: Live job discovery (JobsForce India)
# The provider's public API needs no credentials, so the frontend holds none.
# Searching, filtering and importing all go through the backend.
